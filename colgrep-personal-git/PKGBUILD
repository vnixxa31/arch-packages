# Maintainer: Violet Nixxa <violet+arch@nixxa.net>

pkgname=colgrep-personal-git
_repo=next-plaid
pkgver=1.8.5.r767.gd86b811
pkgrel=1
pkgdesc="Semantic code search powered by ColBERT (personal fork, built from main)"
arch=('x86_64')
url="https://github.com/vnixxa31/next-plaid"
license=('Apache-2.0')
depends=('gcc-libs' 'glibc' 'openssl')
makedepends=('cargo' 'git')
provides=('colgrep')
conflicts=('colgrep' 'colgrep-bin' 'colgrep-git')
options=('!lto' '!debug')
source=("${_repo}::git+https://github.com/vnixxa31/next-plaid.git#branch=main")
sha256sums=('SKIP')

# CI machines are not your machine, so "-march=native" would be unsafe here.
# x86-64-v3 = AVX2-era CPUs (Haswell / Zen 1 and newer). Use 'x86-64' for maximum portability.
_target_cpu=x86-64-v3

pkgver() {
  cd "$_repo"
  local ver
  ver="$(sed -n '/^\[workspace.package\]/,/^\[/{s/^version *= *"\(.*\)"/\1/p}' Cargo.toml)"
  printf '%s.r%s.g%s' "${ver//-/_}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_repo"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_repo"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  export RUSTFLAGS="-C target-cpu=${_target_cpu} --remap-path-prefix=${srcdir}=."
  unset CARGO_ENCODED_RUSTFLAGS
  cargo build --frozen --release -p colgrep
}

package() {
  cd "$_repo"
  install -Dm755 "$srcdir/target/release/colgrep" "$pkgdir/usr/bin/colgrep"
  install -Dm644 colgrep/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
